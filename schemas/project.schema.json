    "cache": {
      "anyOf": [
        {
          "$ref": "#/$defs/Cache"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ai": {
      "anyOf": [
        {
          "$ref": "#/$defs/AI"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "storage": {
      "anyOf": [
        {
          "$ref": "#/$defs/Storage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "auth": {
      "anyOf": [
        {
          "$ref": "#/$defs/Auth"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "admin": {
      "anyOf": [
        {
          "$ref": "#/$defs/Admin"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "jobs": {
      "anyOf": [
        {
          "$ref": "#/$defs/Jobs"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "scheduler": {
      "anyOf": [
        {
          "$ref": "#/$defs/Scheduler"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "observability": {
      "anyOf": [
        {
          "$ref": "#/$defs/Observability"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cloud": {
      "anyOf": [
        {
          "$ref": "#/$defs/Cloud"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "iac": {
      "anyOf": [
        {
          "$ref": "#/$defs/IaC"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "project",
    "architecture"
  ],
  "title": "ProjectConfig",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
