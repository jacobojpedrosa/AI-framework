{
  "$defs": {
    "Design": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "accent": {
          "default": "#245b45",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Accent",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "maxItems": 10,
          "title": "References",
          "type": "array"
        }
      },
      "title": "Design",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "singular": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Singular",
          "type": "string"
        },
        "plural": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Plural",
          "type": "string"
        },
        "fields": {
          "items": {
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "statuses": {
          "items": {
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Statuses",
          "type": "array"
        }
      },
      "required": [
        "name",
        "singular",
        "plural",
        "fields",
        "statuses"
      ],
      "title": "Entity",
      "type": "object"
    },
    "Flow": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "steps": {
          "items": {
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 2,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "name",
        "steps"
      ],
      "title": "Flow",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "source"
      ],
      "title": "Reference",
      "type": "object"
    },
    "Seed": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 2000,
          "title": "Description",
          "type": "string"
        },
        "status": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "title",
        "status"
      ],
      "title": "Seed",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "product_version": {
      "const": 1,
      "default": 1,
      "title": "Product Version",
      "type": "integer"
    },
    "name": {
      "anyOf": [
        {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "title": {
      "anyOf": [
        {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "summary": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    },
    "personas": {
      "anyOf": [
        {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 30,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Personas"
    },
    "use_cases": {
      "anyOf": [
        {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 30,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Use Cases"
    },
    "flows": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Flow"
          },
          "maxItems": 20,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Flows"
    },
    "screens": {
      "anyOf": [
        {
          "items": {
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Screens"
    },
    "entities": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Entity"
          },
          "maxItems": 20,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entities"
    },
    "integrations": {
      "anyOf": [
        {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 30,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Integrations"
    },
    "ai_capabilities": {
      "anyOf": [
        {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 30,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ai Capabilities"
    },
    "constraints": {
      "anyOf": [
        {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 30,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Constraints"
    },
    "design": {
      "$ref": "#/$defs/Design"
    },
    "seed": {
      "items": {
        "$ref": "#/$defs/Seed"
      },
      "maxItems": 50,
      "title": "Seed",
      "type": "array"
    }
  },
  "title": "ProductDefinition",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
