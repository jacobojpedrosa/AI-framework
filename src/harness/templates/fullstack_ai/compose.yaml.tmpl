name: ${COMPOSE_PROJECT_NAME:-@@PROJECT@@}

services:
  api:
    build:
      context: ./services/@@API@@
      target: development
    ports:
      - "127.0.0.1:${API_PORT:-8000}:8000"
    init: true
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=2)"]
      interval: 3s
      timeout: 3s
      retries: 20
      start_period: 5s
  web:
    build:
      context: ./apps/@@WEB@@
    ports:
      - "127.0.0.1:${WEB_PORT:-5173}:5173"
    environment:
      API_INTERNAL_URL: http://api:8000
    depends_on:
      api:
        condition: service_healthy
    init: true
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:5173').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
      interval: 3s
      timeout: 3s
      retries: 20
      start_period: 5s
