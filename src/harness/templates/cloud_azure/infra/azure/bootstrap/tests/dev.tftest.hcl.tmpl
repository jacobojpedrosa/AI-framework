mock_provider "azurerm" {
  override_during = plan
  mock_resource "azurerm_container_registry" {
    defaults = {
      id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/@@AZURE_RESOURCE@@/providers/Microsoft.ContainerRegistry/registries/@@AZURE_REGISTRY@@00000000"
    }
  }
}
variables {
  subscription_id = "00000000-0000-0000-0000-000000000000"
  tenant_id       = "00000000-0000-0000-0000-000000000000"
}
run "bootstrap_plan" {
  command = plan
  assert {
    condition     = azurerm_container_registry.images.admin_enabled == false
    error_message = "Registry admin credentials must remain disabled."
  }
  assert {
    condition     = azurerm_role_assignment.pull.role_definition_name == "AcrPull" && azurerm_role_assignment.pull.scope == azurerm_container_registry.images.id
    error_message = "Image pull must be scoped to this registry."
  }
}
