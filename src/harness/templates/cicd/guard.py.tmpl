"""Fail closed before cloud authentication; no account discovery."""

import json
import os
import re
import urllib.request

from deploy import configuration


def protected_environment(document, policies):
    rules = document.get("protection_rules", [])
    reviewers = [
        rule
        for rule in rules
        if rule.get("type") == "required_reviewers"
        and rule.get("prevent_self_review") is True
        and rule.get("reviewers")
    ]
    policy = document.get("deployment_branch_policy") or {}
    branches = policies.get("branch_policies", [])
    return bool(
        reviewers
        and document.get("can_admins_bypass") is False
        and policy.get("custom_branch_policies") is True
        and policy.get("protected_branches") is False
        and len(branches) == 1
        and branches[0].get("name") == "main"
        and branches[0].get("type") == "branch"
    )


def check_event(env):
    stage = env.get("DEPLOY_STAGE")
    expected = {
        "dev": ("push", "refs/heads/develop"),
        "prod": ("workflow_dispatch", "refs/heads/main"),
    }
    if stage not in expected:
        raise ValueError("Unknown deployment stage")
    event, ref = expected[stage]
    if env.get("GITHUB_EVENT_NAME") != event or env.get("GITHUB_REF") != ref:
        raise ValueError("Deployment event or branch is not allowed")
    if stage == "prod" and not re.fullmatch(r"sha256:[a-f0-9]{64}", env.get("IMAGE_DIGEST", "")):
        raise ValueError("Production requires a reviewed immutable digest")


def main():
    check_event(os.environ)
    configuration(os.environ)
    if os.environ["DEPLOY_STAGE"] == "prod":
        token = os.environ.get("ENVIRONMENT_READ_TOKEN", "")
        repo = os.environ.get("GITHUB_REPOSITORY", "")
        if not token or not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repo):
            raise ValueError("Missing environment read token or repository")
        # Fixed GitHub.com endpoint: never send this token to a configurable host.
        url = "https://api.github.com/repos/" + repo + "/environments/prod"

        def get(suffix):
            request = urllib.request.Request(
                url + suffix,
                headers={
                    "Authorization": "Bearer " + token,
                    "Accept": "application/vnd.github+json",
                    "X-GitHub-Api-Version": "2022-11-28",
                },
            )
            with urllib.request.urlopen(request, timeout=20) as response:
                return json.load(response)

        if not protected_environment(get(""), get("/deployment-branch-policies")):
            raise ValueError("PROD environment protection is missing or unsupported")
    print("Deployment gate passed")


if __name__ == "__main__":
    main()
