import math
from threading import RLock

from app.domain.records import validate_key
from app.domain.vectors import Match, validate_embedding, validate_limit, validate_vector


class MemoryVectors:
    def __init__(self) -> None:
        self._items: dict[str, tuple[float, ...]] = {}
        self._lock = RLock()

    def put(self, key: str, vector: tuple[float, ...]) -> None:
        validate_embedding(key, vector)
        with self._lock:
            self._items[key] = tuple(vector)

    def nearest(self, vector: tuple[float, ...], limit: int = 10) -> list[Match]:
        validate_vector(vector)
        validate_limit(limit)
        with self._lock:
            matches = [Match(key, math.dist(vector, value)) for key, value in self._items.items()]
        return sorted(matches, key=lambda match: (match.distance, match.key))[:limit]

    def delete(self, key: str) -> bool:
        validate_key(key)
        with self._lock:
            return self._items.pop(key, None) is not None
