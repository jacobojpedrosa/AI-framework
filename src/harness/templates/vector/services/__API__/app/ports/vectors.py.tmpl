from typing import Protocol

from app.domain.vectors import Match


class VectorStore(Protocol):
    """Three-dimensional Euclidean search, sorted by (distance, key)."""

    def put(self, key: str, vector: tuple[float, ...]) -> None: ...
    def nearest(self, vector: tuple[float, ...], limit: int = 10) -> list[Match]: ...
    def delete(self, key: str) -> bool: ...
