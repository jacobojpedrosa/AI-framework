from fastapi.testclient import TestClient

from app.infrastructure.cloud_server import cloud_app


def test_built_frontend_and_api_share_origin(tmp_path):
    (tmp_path / "index.html").write_text("<html>Built frontend</html>")
    with TestClient(cloud_app(tmp_path)) as client:
        assert client.get("/").text == "<html>Built frontend</html>"
        assert client.get("/api/health").json()["status"] == "ok"
        assert client.get("/api/readiness").status_code == 200
        assert client.get("/api/openapi.json").json()["openapi"]
        assert client.get("/api/not-registered").status_code == 404
        assert client.get("/.env").status_code == 404
