FROM node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS web-build
WORKDIR /web
COPY apps/@@WEB@@/package.json apps/@@WEB@@/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY apps/@@WEB@@/ ./
RUN npm run build

FROM python:3.12-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8080 TELEMETRY_EXPORTER=console
WORKDIR /app
COPY services/@@API@@/requirements.txt services/@@API@@/requirements-telemetry.txt ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements.txt \
    && useradd --create-home --uid 10001 app
COPY --chown=app:app services/@@API@@/app ./app
COPY --from=web-build --chown=app:app /web/dist ./static
USER app
EXPOSE 8080
CMD ["python", "-m", "app.infrastructure.cloud_server"]
