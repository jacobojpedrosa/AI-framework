import re
from types import SimpleNamespace

import pytest
from fastapi import FastAPI
from fastapi.testclient import TestClient

from app.adapters.local_identity import hash_password
from app.infrastructure import auth_runtime, jobs_runtime
from app.infrastructure.auth_bootstrap import install_auth
from app.infrastructure.auth_runtime import AuthRuntime
from app.infrastructure.auth_settings import AuthSettings


@pytest.fixture(scope="module")
def password_hash():
    return hash_password("test-password-only-123")


@pytest.fixture
def admin_client(monkeypatch, password_hash):
    monkeypatch.setattr(jobs_runtime, "ADAPTER", "memory")
    monkeypatch.setattr(auth_runtime, "AUTHORIZATION", "permissions")
    app = FastAPI()
    app.state.resources = SimpleNamespace(repository=None)
    jobs_runtime.install_jobs(app)
    settings = AuthSettings(
        provider="local",
        secret="test-only-session-secret" * 3,
        secure=False,
        username="admin",
        password_hash=password_hash,
        permissions=frozenset({"admin:access", "schedules:read", "schedules:write"}),
    )
    install_auth(app, AuthRuntime(settings))
    with TestClient(app) as client:
        yield client, app


def login(client):
    response = client.get("/auth/login")
    token = re.search(r'name="csrf" value="([^"]+)"', response.text).group(1)
    assert (
        client.post(
            "/auth/login",
            data={"username": "admin", "password": "test-password-only-123", "csrf": token},
            follow_redirects=False,
        ).status_code
        == 303
    )


def test_anonymous_blocked_then_admin_manages_registered_schedule(admin_client):
    client, app = admin_client
    assert client.get("/admin/schedules", follow_redirects=False).status_code == 303
    assert client.post("/auth/login", data={"username": "admin"}).status_code == 403
    login(client)
    response = client.get("/admin/schedules")
    assert response.status_code == 200 and "heartbeat-default" in response.text
    token = client.cookies["starlette_admin_csrftoken"]
    data = {"name": "heartbeat-default", "enabled": "true", "interval_seconds": "1"}
    assert client.post("/admin/schedules", data=data).status_code == 403
    headers = {"X-CSRFToken": token}
    assert client.post("/admin/schedules", data=data, headers=headers).status_code == 200
    entries = client.portal.call(app.state.jobs.schedules.list)
    assert entries[0].enabled and entries[0].interval_seconds == 1
    for changes in ({"name": "os.system"}, {"job": "os.system"}, {"interval_seconds": "0"}):
        assert (
            client.post("/admin/schedules", data=data | changes, headers=headers).status_code == 400
        )
    assert client.get("/admin/users").status_code == 404
    assert client.post("/admin/logout", headers=headers, follow_redirects=False).status_code == 303
    assert client.get("/admin/schedules", follow_redirects=False).status_code == 303


def test_read_permission_does_not_grant_write(admin_client):
    client, app = admin_client
    login(client)
    from dataclasses import replace

    app.state.auth.settings = replace(
        app.state.auth.settings, permissions=frozenset({"admin:access", "schedules:read"})
    )
    assert client.get("/admin/schedules").status_code == 200
    response = client.post(
        "/admin/schedules",
        data={"name": "heartbeat-default", "enabled": "true", "interval_seconds": "1"},
        headers={"X-CSRFToken": client.cookies["starlette_admin_csrftoken"]},
    )
    assert response.status_code == 403
    app.state.auth.settings = replace(app.state.auth.settings, roles=frozenset())
    assert client.get("/admin/schedules").status_code == 403
