import ast
import sys
from pathlib import Path

# Inner layers may use stdlib and only these other inner layers.
ALLOWED = {
    "domain": {"domain"},
    "ports": {"domain", "ports"},
    "application": {"domain", "ports", "application"},
}


def test_inner_layers_have_no_framework_or_adapter_imports():
    root = Path(__file__).resolve().parents[1] / "app"
    for layer, allowed in ALLOWED.items():
        for path in (root / layer).rglob("*.py"):
            for node in ast.walk(ast.parse(path.read_text())):
                if isinstance(node, ast.Import):
                    modules = [alias.name for alias in node.names]
                elif isinstance(node, ast.ImportFrom):
                    assert node.level == 0, f"Use explicit absolute imports in {path}"
                    modules = [node.module or ""]
                else:
                    continue
                for module in modules:
                    parts = module.split(".")
                    if parts[0] == "app":
                        assert len(parts) > 1 and parts[1] in allowed, (path, module)
                    else:
                        assert parts[0] in sys.stdlib_module_names, (path, module)
