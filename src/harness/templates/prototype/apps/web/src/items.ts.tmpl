import product from "./product.json";

export interface ItemInput {
  title: string;
  description: string;
  status: string;
}
export interface Item extends ItemInput {
  id: string;
}

function item(value: unknown): Item {
  if (typeof value !== "object" || value === null)
    throw new Error("Invalid API response");
  const result = value as Record<string, unknown>;
  if (
    typeof result.id !== "string" ||
    typeof result.title !== "string" ||
    typeof result.description !== "string" ||
    typeof result.status !== "string" ||
    !product.entity.statuses.includes(result.status)
  )
    throw new Error("Invalid API response");
  return result as unknown as Item;
}

async function request(path: string, init: RequestInit = {}): Promise<unknown> {
  const response = await fetch(path, init);
  if (!response.ok) {
    if (response.status === 404)
      throw new Error("This item could not be found.");
    if (response.status === 409)
      throw new Error("The prototype collection is full.");
    if (response.status === 422)
      throw new Error("Check the title, description and status.");
    throw new Error("We couldn’t reach your collection. Please try again.");
  }
  return response.json();
}

export async function listItems(signal?: AbortSignal): Promise<Item[]> {
  const result = await request("/api/items", { signal });
  if (!Array.isArray(result)) throw new Error("Invalid API response");
  return result.map(item);
}

export async function getItem(id: string, signal?: AbortSignal): Promise<Item> {
  return item(
    await request(`/api/items/${encodeURIComponent(id)}`, { signal }),
  );
}

export async function createItem(input: ItemInput): Promise<Item> {
  return item(
    await request("/api/items", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(input),
    }),
  );
}
