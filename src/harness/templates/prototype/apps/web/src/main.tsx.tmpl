import {
  StrictMode,
  useEffect,
  useState,
  type CSSProperties,
  type FormEvent,
} from "react";
import { createRoot } from "react-dom/client";
import { createItem, getItem, listItems, type Item } from "./items.ts";
import product from "./product.json";
import "./style.css";

const label = (value: string) => value.replaceAll("-", " ");

function App() {
  const [route, setRoute] = useState(location.hash || "#/");
  const [items, setItems] = useState<Item[]>([]);
  const [selected, setSelected] = useState<Item | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [attempt, setAttempt] = useState(0);
  const [query, setQuery] = useState("");
  const [filter, setFilter] = useState("");
  const [saving, setSaving] = useState(false);
  const [title, setTitle] = useState("");
  const [description, setDescription] = useState("");
  const [status, setStatus] = useState(product.entity.statuses[0]);
  const isList = route === "#/";
  const isCreate = route === "#/new";
  const isDetail = /^#\/items\/[^/]+$/.test(route);

  useEffect(() => {
    const change = () => setRoute(location.hash || "#/");
    window.addEventListener("hashchange", change);
    return () => window.removeEventListener("hashchange", change);
  }, []);

  useEffect(() => {
    const controller = new AbortController();
    setError("");
    setSelected(null);
    setLoading(isList || isDetail);
    if (isList) {
      listItems(controller.signal)
        .then((value) => {
          if (!controller.signal.aborted) setItems(value);
        })
        .catch((err: unknown) => {
          if (!controller.signal.aborted)
            setError(
              err instanceof Error ? err.message : "Unable to load items.",
            );
        })
        .finally(() => {
          if (!controller.signal.aborted) setLoading(false);
        });
    } else if (isDetail) {
      getItem(route.slice(8), controller.signal)
        .then((value) => {
          if (!controller.signal.aborted) setSelected(value);
        })
        .catch((err: unknown) => {
          if (!controller.signal.aborted)
            setError(
              err instanceof Error ? err.message : "Unable to load item.",
            );
        })
        .finally(() => {
          if (!controller.signal.aborted) setLoading(false);
        });
    }
    return () => controller.abort();
  }, [route, attempt, isList, isDetail]);

  const filtered = items.filter(
    (item) =>
      (!filter || item.status === filter) &&
      `${item.title} ${item.description}`
        .toLowerCase()
        .includes(query.toLowerCase()),
  );

  async function submit(event: FormEvent) {
    event.preventDefault();
    if (saving) return;
    if (!title.trim()) {
      setError("Please add a title.");
      return;
    }
    setSaving(true);
    setError("");
    try {
      const created = await createItem({
        title: title.trim(),
        description,
        status,
      });
      setTitle("");
      setDescription("");
      setStatus(product.entity.statuses[0]);
      if (location.hash === "#/new") location.hash = `/items/${created.id}`;
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Unable to save. Please try again.",
      );
    } finally {
      setSaving(false);
    }
  }

  return (
    <div
      className="shell"
      style={{ "--accent": product.accent } as CSSProperties}
    >
      <a
        className="skip-link"
        href="#content"
        onClick={(event) => {
          event.preventDefault();
          document.getElementById("content")?.focus();
        }}
      >
        Skip to content
      </a>
      <aside className="sidebar">
        <a href="#/" className="brand">
          <span className="brand-icon" aria-hidden="true">
            {product.title[0].toLowerCase()}.
          </span>
          {product.title}
        </a>
        <p className="nav-label">WORKSPACE</p>
        <nav aria-label="Main navigation">
          <a
            className={isList ? "nav-link active" : "nav-link"}
            href="#/"
            aria-current={isList ? "page" : undefined}
          >
            <span aria-hidden="true">▦</span> All items
          </a>
          <a
            className={isCreate ? "nav-link active" : "nav-link"}
            href="#/new"
            aria-current={isCreate ? "page" : undefined}
          >
            <span aria-hidden="true">＋</span> Add an item
          </a>
        </nav>
        <div className="sidebar-note">
          <span className="small-dot" />A little clarity goes a long way.
          <p>
            Collect the details.
            <br />
            See the bigger picture.
          </p>
        </div>
        <div className="workspace-owner">
          <span className="avatar">W</span>
          <div>
            Team workspace<small>Local prototype</small>
          </div>
        </div>
      </aside>
      <div className="main-shell">
        <header className="topbar">
          <span>
            Workspace <span aria-hidden="true">/</span> {product.entity.plural}
          </span>
          <span className="prototype-label">Sample workspace</span>
        </header>
        <main id="content" tabIndex={-1}>
          {isList ? (
            <>
              <section className="page-heading">
                <div>
                  <p className="eyebrow">THE BIG PICTURE</p>
                  <h1>{product.entity.plural}</h1>
                  <p className="lead">{product.summary}</p>
                </div>
                <a className="button primary" href="#/new">
                  <span aria-hidden="true">＋</span> Add{" "}
                  {product.entity.singular.toLowerCase()}
                </a>
              </section>
              {!loading && !error && (
                <section className="overview" aria-label="Collection overview">
                  <div className="overview-total">
                    <span>Total items</span>
                    <strong>{items.length.toString().padStart(2, "0")}</strong>
                    <small>Every idea starts here</small>
                  </div>
                  {product.entity.statuses.slice(0, 3).map((value, index) => (
                    <div key={value}>
                      <span className="status-label">
                        <i className={`dot tone-${index % 3}`} />
                        {label(value)}
                      </span>
                      <strong>
                        {items
                          .filter((item) => item.status === value)
                          .length.toString()
                          .padStart(2, "0")}
                      </strong>
                      <small>In your collection</small>
                    </div>
                  ))}
                </section>
              )}
              <section className="collection" aria-label="Items">
                <div className="collection-toolbar">
                  <h2>All {product.entity.plural.toLowerCase()}</h2>
                  <div className="filters">
                    <input
                      type="search"
                      aria-label="Search items"
                      placeholder="Search your collection…"
                      value={query}
                      onChange={(event) => setQuery(event.target.value)}
                    />
                    <select
                      aria-label="Filter by status"
                      value={filter}
                      onChange={(event) => setFilter(event.target.value)}
                    >
                      <option value="">All statuses</option>
                      {product.entity.statuses.map((value) => (
                        <option key={value} value={value}>
                          {label(value)}
                        </option>
                      ))}
                    </select>
                  </div>
                </div>
                {loading && (
                  <p className="state-message" role="status">
                    Loading your collection…
                  </p>
                )}
                {!loading &&
                  !error &&
                  (filtered.length ? (
                    <ul className="item-list">
                      {filtered.map((item, index) => (
                        <li key={item.id}>
                          <a href={`#/items/${encodeURIComponent(item.id)}`}>
                            <span className="item-number">
                              {String(index + 1).padStart(2, "0")}
                            </span>
                            <div className="item-copy">
                              <h3>{item.title}</h3>
                              <p>
                                {item.description || "No extra details yet."}
                              </p>
                            </div>
                            <span className="status-badge">
                              {label(item.status)}
                            </span>
                            <span className="item-arrow" aria-hidden="true">
                              ↗
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <div className="state-message">
                      <h3>No items found</h3>
                      <p>
                        {items.length
                          ? "Try a different search or status."
                          : "Add your first item to start the conversation."}
                      </p>
                      <a href="#/new">Add an item →</a>
                    </div>
                  ))}
                {!loading && !error && (
                  <div className="collection-footer">
                    <span>
                      {filtered.length} of {items.length} items
                    </span>
                    <span>A shared space for better decisions</span>
                  </div>
                )}
              </section>
            </>
          ) : isCreate ? (
            <>
              <a className="back-link" href="#/">
                ← Back to collection
              </a>
              <p className="eyebrow">MAKE ROOM FOR A NEW IDEA</p>
              <h1>Add {product.entity.singular.toLowerCase()}</h1>
              <p className="lead">
                A clear title and a little context are a great start.
              </p>
              <form className="editor" onSubmit={submit}>
                <label htmlFor="title">
                  Title <span>Required</span>
                </label>
                <input
                  id="title"
                  required
                  maxLength={80}
                  value={title}
                  onChange={(event) => setTitle(event.target.value)}
                  placeholder="What should we pay attention to?"
                />
                <label htmlFor="description">Description</label>
                <textarea
                  id="description"
                  maxLength={2000}
                  rows={6}
                  value={description}
                  onChange={(event) => setDescription(event.target.value)}
                  placeholder="Add the details that will help your team understand…"
                />
                <small>{description.length} / 2000 characters</small>
                <label htmlFor="status">Status</label>
                <select
                  id="status"
                  value={status}
                  onChange={(event) => setStatus(event.target.value)}
                >
                  {product.entity.statuses.map((value) => (
                    <option key={value} value={value}>
                      {label(value)}
                    </option>
                  ))}
                </select>
                <div className="form-actions">
                  <a href="#/" className="button secondary">
                    Cancel
                  </a>
                  <button className="button primary" disabled={saving}>
                    {saving ? "Saving…" : "Save item"}
                  </button>
                </div>
              </form>
            </>
          ) : isDetail ? (
            <>
              <a className="back-link" href="#/">
                ← Back to collection
              </a>
              {loading && <p role="status">Loading item…</p>}
              {selected && (
                <article className="detail">
                  <p className="eyebrow">{product.entity.singular}</p>
                  <h1>{selected.title}</h1>
                  <span className="status-badge">{label(selected.status)}</span>
                  <hr />
                  <h2>The context</h2>
                  <p className="detail-description">
                    {selected.description || "No extra details yet."}
                  </p>
                  <footer>
                    Item reference <code>{selected.id}</code>
                  </footer>
                </article>
              )}
            </>
          ) : (
            <section className="state-message">
              <h1>Page not found</h1>
              <a href="#/">Back to collection</a>
            </section>
          )}
          {error && (
            <div className="error-message" role="alert">
              <p>{error}</p>
              {!isCreate && (
                <button
                  className="button secondary"
                  onClick={() => setAttempt(attempt + 1)}
                >
                  Try again
                </button>
              )}
            </div>
          )}
          <footer className="page-footer">
            Built for the conversations that move things forward.
            <span>Synthetic data · resets when the API restarts</span>
          </footer>
        </main>
      </div>
    </div>
  );
}

createRoot(document.getElementById("root")!).render(
  <StrictMode>
    <App />
  </StrictMode>,
);
