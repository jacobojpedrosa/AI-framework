import json
from pathlib import Path

from fastapi import FastAPI

from app.adapters.http import health_router
from app.adapters.items_http import items_router
from app.adapters.local import ProcessProbe, SystemClock
from app.adapters.memory_items import MemoryItems
from app.application.items import Items
from app.application.readiness import CheckReadiness
from app.domain.items import Item

SERVICE_NAME = "api"


def create_app(readiness: CheckReadiness | None = None) -> FastAPI:
    app = FastAPI(
        title="@@PROJECT@@",
        version="0.1.0",
        docs_url="/api/docs",
        redoc_url=None,
        openapi_url="/api/openapi.json",
    )
    if readiness is None:
        readiness = CheckReadiness(SERVICE_NAME, {"process": ProcessProbe()}, SystemClock())
    data = json.loads(Path(__file__).with_name("product.json").read_text())
    seed = tuple(Item(id=f"sample-{i + 1}", **item) for i, item in enumerate(data["seed"]))
    app.include_router(health_router(SERVICE_NAME, readiness))
    app.include_router(items_router(Items(MemoryItems(seed), tuple(data["statuses"]))))
    return app
