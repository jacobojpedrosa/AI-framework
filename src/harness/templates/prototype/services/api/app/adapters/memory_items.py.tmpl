from threading import Lock
from uuid import uuid4

from app.domain.items import CollectionFull, Item


class MemoryItems:
    def __init__(self, seed: tuple[Item, ...] = (), limit: int = 1000):
        self._items = {item.id: item for item in seed}
        self._lock = Lock()
        self._limit = limit

    def list(self) -> tuple[Item, ...]:
        with self._lock:
            return tuple(reversed(tuple(self._items.values())))

    def get(self, item_id: str) -> Item | None:
        with self._lock:
            return self._items.get(item_id)

    def add(self, title: str, description: str, status: str) -> Item:
        with self._lock:
            if len(self._items) >= self._limit:
                raise CollectionFull
            item = Item(str(uuid4()), title, description, status)
            self._items[item.id] = item
            return item
