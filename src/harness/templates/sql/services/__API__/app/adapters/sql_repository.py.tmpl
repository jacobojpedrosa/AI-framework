from sqlalchemy import Engine, create_engine, text
from sqlalchemy.engine import make_url

from app.domain.records import Record, validate_key


def open_engine(url: str) -> Engine:
    driver = make_url(url).drivername
    if driver == "sqlite":
        return create_engine(url, connect_args={"timeout": 5})
    if driver == "postgresql+psycopg":
        return create_engine(
            url,
            connect_args={"connect_timeout": 5, "options": "-c statement_timeout=5000"},
            pool_pre_ping=True,
            pool_size=5,
            max_overflow=0,
            pool_timeout=5,
        )
    raise ValueError("Use sqlite:/// or postgresql+psycopg:// URLs")


class SqlRepository:
    """SQLite/PostgreSQL adapter; one committed transaction per operation."""

    def __init__(self, engine: Engine, namespace: str = "app") -> None:
        validate_key(namespace)
        self.engine = engine
        self.namespace = namespace

    def put(self, record: Record) -> None:
        with self.engine.begin() as connection:
            connection.execute(
                text(
                    "INSERT INTO harness_records (namespace, key, value) "
                    "VALUES (:namespace, :key, :value) "
                    "ON CONFLICT (namespace, key) DO UPDATE SET value = excluded.value"
                ),
                {"namespace": self.namespace, "key": record.key, "value": record.value},
            )

    def get(self, key: str) -> Record | None:
        validate_key(key)
        with self.engine.connect() as connection:
            row = connection.execute(
                text("SELECT value FROM harness_records WHERE namespace=:namespace AND key=:key"),
                {"namespace": self.namespace, "key": key},
            ).first()
        return None if row is None else Record(key, row[0])

    def delete(self, key: str) -> bool:
        validate_key(key)
        with self.engine.begin() as connection:
            result = connection.execute(
                text("DELETE FROM harness_records WHERE namespace=:namespace AND key=:key"),
                {"namespace": self.namespace, "key": key},
            )
            return result.rowcount == 1

    def check(self) -> bool:
        with self.engine.connect() as connection:
            connection.execute(text("SELECT namespace, key, value FROM harness_records LIMIT 0"))
        return True
